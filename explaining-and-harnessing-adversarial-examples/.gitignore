__pycache__/
*.pyc
.venv/
.pytest_cache/
# Result JSONs ARE committed: they are small parsed numbers that record the
# reproduction's measured values vs the paper targets (a reader can verify
# without re-running). Do NOT gitignore results/.
# downloaded MNIST IDX files (regenerated by fgsm_repro.data on first run)
data/mnist/
mnist/

# arXiv e-print unpack under paper/source/: track ONLY the LaTeX/bibliography
# sources (.tex/.bbl/.bib) — the maths reference. Figures (.png/.pdf), style
# files (.sty/.bst) and the eprint tarball are ignored: they are not reproduced
# from and bloat every clone. Files remain unpacked on disk for reference.
paper/source/*
!paper/source/*.tex
!paper/source/*.bbl
!paper/source/*.bib
