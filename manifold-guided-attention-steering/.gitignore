# Python build artifacts
__pycache__/
*.pyc

# Local virtualenv (recreated from requirements.txt)
.venv/

# IMPORTANT: runs/ and manifolds/ are NOT ignored. They hold committed evidence
# (per-run JSON, blocked markers, fitted manifolds). A result whose output file is
# gitignored is a claim with its evidence deleted.

# Editor / OS scratch
*.tmp
.DS_Store

# run_all_arms.sh / smoke.sh transient scratch (regenerated per run, not evidence)
runs/_arms_map.tsv
runs/_arms_full.tsv
runs/_arms_keys.tsv
runs/_arms_runnable.tsv
runs/_fit_pairs.tsv
runs/log__smoke.log
